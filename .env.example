# 示例，不含真实凭据；可复制为 .env.local，后端从中读取两个服务的 API Key。
# 嵌入/重排开关及批大小也支持 .env.local，环境变量优先。
GITEE_AI_API_KEY=
MEDIX_EMBEDDING_PROVIDER=gitee
# 可选：gitee / siliconflow / local。siliconflow 使用 Qwen/Qwen3-Embedding-8B。
MEDIX_EMBEDDING_BATCH_SIZE=8
SILICONFLOW_API_KEY=xxx
# 填好硅基流动密钥后可设置 siliconflow；默认 none，不发送重排请求。
MEDIX_RERANK_PROVIDER=none
# 可选：已下载的 Qwen tokenizer 目录；只需 tokenizer，不下载8B模型权重。
# MEDIX_EMBEDDING_TOKENIZER_PATH=D:/models/Qwen3-Embedding-8B-tokenizer
# MEDIX_EVIDENCE_ROOT=D:/medix-data/evidence
# 本地离线 BGE：显式设置 MEDIX_EMBEDDING_PROVIDER=local
