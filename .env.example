# Copy this file to .env.local (ignored by Git). run_web.py loads it,
# then .env.sms; process environment variables take priority.
MEDIX_ENV=development
MEDIX_DATA_DIR=.medix-data
# Development origins are derived from --port; override only when needed.
# MEDIX_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
MEDIX_ALLOW_REGISTRATION=true
# Use different stable namespaces on each developer's machine / demo environment.
MEDIX_IDENTITY_NAMESPACE=local
# Optional: MEDIX_DATABASE_URL=sqlite:///D:/medix-data/app.db
# Production requires MEDIX_ENV=production, HTTPS origins and registration policy.

# Optional SMS login: see docs/SMS-SETUP.md. run_web.py loads ignored .env.sms.
# MEDIX_SMS_ACCESS_KEY_ID=
# MEDIX_SMS_ACCESS_KEY_SECRET=
# MEDIX_SMS_SIGN_NAME=
# MEDIX_SMS_TEMPLATE_CODE=100001

# 示例，不含真实凭据；可复制为 .env.local。
MEDIX_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=xxx
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=8192
# 证据版纯文本默认单次请求；swarm 可恢复原多 Agent 生成。
MEDIX_EVIDENCE_GENERATOR=direct
# MEDIX_LLM_PROVIDER=auto 可恢复已有 OpenAI/ARK/外部配置优先的自动选择。
# 嵌入/重排开关及批大小也支持 .env.local，环境变量优先。
GITEE_AI_API_KEY=
MEDIX_EMBEDDING_PROVIDER=local
# 可选：gitee / siliconflow / local。siliconflow 使用 Qwen/Qwen3-Embedding-8B。
MEDIX_EMBEDDING_BATCH_SIZE=8
SILICONFLOW_API_KEY=xxx
# 填好硅基流动密钥后可设置 siliconflow；默认 none，不发送重排请求。
MEDIX_RERANK_PROVIDER=none
# 可选：已下载的 Qwen tokenizer 目录；只需 tokenizer，不下载8B模型权重。
# MEDIX_EMBEDDING_TOKENIZER_PATH=D:/models/Qwen3-Embedding-8B-tokenizer
# 默认自动持久化到当前项目knowledge/data/evidence；无需设置原电脑绝对路径。
# 可选覆盖根目录，每个索引版本独立存放。
# MEDIX_EVIDENCE_ROOT=E:/workspace/medix-agent-swarm-20261028/knowledge/data/evidence
# 本地离线 BGE：显式设置 MEDIX_EMBEDDING_PROVIDER=local

# Legacy KB backend: auto (Milvus then labeled text fallback), milvus (strict), mini (text only).
# Explicit MEDIX_KB_MODE=evidence never falls back to mini.
MEDIX_KB_BACKEND=auto
