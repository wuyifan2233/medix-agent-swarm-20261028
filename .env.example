# The application reads process environment variables; this file is an example,
# not automatically loaded. Set them in PowerShell or your deployment manager.
MEDIX_ENV=development
MEDIX_DATA_DIR=.medix-data
MEDIX_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
MEDIX_ALLOW_REGISTRATION=true
# Use different stable namespaces on each developer's machine / demo environment.
MEDIX_IDENTITY_NAMESPACE=local
# Optional: MEDIX_DATABASE_URL=sqlite:///D:/medix-data/app.db
# Production requires MEDIX_ENV=production, HTTPS origins and registration policy.

# Optional SMS login: see docs/SMS-SETUP.md. run_web.py loads ignored .env.sms.
# MEDIX_SMS_ACCESS_KEY_ID=
# MEDIX_SMS_ACCESS_KEY_SECRET=
# MEDIX_SMS_SIGN_NAME=
# MEDIX_SMS_TEMPLATE_CODE=100001
