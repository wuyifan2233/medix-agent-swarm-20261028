# Copy this file to config/local.env and fill in the values for this machine.
# config/local.env is not committed. Do not put QQ numbers, passwords, or OneBot tokens here.

# Folder of an extracted SnowLuma lite package, for example SnowLuma-v2.2.1-win-x64-lite.
# Download it from https://github.com/SnowLuma/SnowLuma/releases
# The folder must contain index.mjs. This repository does not include SnowLuma itself.
MEDIX_SNOWLUMA_HOME=

# Optional. Use this when QQ.exe is not under Program Files\Tencent\QQNT or QQ.
MEDIX_QQ_EXE=
